# Copy to env.local (gitignored) or set as GitHub Actions secrets.
# NEVER put real values in tracked files. NEVER commit env.local / .p8 / .p12.

# App Store Connect API key (Users and Access → Keys)
APP_STORE_CONNECT_KEY_ID=
APP_STORE_CONNECT_ISSUER_ID=

# Local runs: absolute path to your AuthKey_*.p8 (file itself must stay outside git)
# APP_STORE_CONNECT_KEY_PATH=

# CI only: key material via GitHub Actions secret APP_STORE_CONNECT_KEY_CONTENT
# Prefer base64 of the .p8 file, then set:
# APP_STORE_CONNECT_KEY_IS_BASE64=true

# Optional overrides (non-secret)
# BUILD_NAME=4.0.18
# BUILD_NUMBER=115
# ASC_APP_IDENTIFIER_IOS=com.backyardbrains.Backyard-Brains
# ASC_APP_IDENTIFIER_MAC=com.example.spikerboxArchitecture
# ASC_TEAM_ID=MLGRKD657P
# ASC_ITUNES_TEAM_ID=
# SKIP_WAITING_FOR_BUILD_PROCESSING=true
# ALLOW_PARTIAL_DEPLOY=true
